# This file is for standalone Python development only.
# The Electron app uses Settings UI for credential management.
#
# Copy this to .env and fill in your actual keys for running
# the Python agent directly (outside the Electron app).
# NEVER commit .env to git

# OpenRouter (for Claude, GPT, Gemini via OpenRouter)
OPENROUTER_API_KEY=***

# Anthropic (direct)
ANTHROPIC_API_KEY=***

# Alibaba DashScope (Qwen models - Coding Plan)
DASHSCOPE_API_KEY=***

# Xiaomi MiMo (Token Plan)
XIAOMI_API_KEY=***
