{
  "name": "hermes-agent-desktop",
  "version": "1.0.0",
  "description": "Hermes Agent Desktop - AI Agent for Windows",
  "main": "dist-electron/main.js",
  "author": "Carly <carly17s@github>",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:win:setup": "npm run build && electron-builder --win nsis --config electron-builder.yml",
    "build:win:portable": "npm run build && electron-builder --win portable --config electron-builder.yml",
    "build:win:msi": "npm run build && electron-builder --win msi --config electron-builder.yml",
    "build:all": "npm run build && electron-builder --win --config electron-builder.yml",
    "clean": "rm -rf node_modules dist dist-electron release",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0",
    "node-pty": "^1.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "lucide-react": "^0.344.0",
    "postcss": "^8.4.35",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^6.0.0"
  }
}
