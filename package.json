{
  "name": "hermes-agent-desktop",
  "version": "1.0.0",
  "description": "Hermes Agent Desktop - AI Agent for Windows",
  "main": "dist-electron/main.js",
  "author": "Carly <carly17s@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carly17s/hermes-windows.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:win:setup": "npm run build && electron-builder --win nsis --config electron-builder.yml",
    "build:win:portable": "npm run build && electron-builder --win portable --config electron-builder.yml",
    "build:all": "npm run build && electron-builder --win --config electron-builder.yml",
    "clean": "rimraf node_modules dist dist-electron release",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:python": "cd src/python/hermes-agent && python -m pytest tests/ -v",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lucide-react": "^1.14.0",
    "postcss": "^8.4.35",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.2.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.27.0",
    "vite": "^6.0.0"
  }
}
